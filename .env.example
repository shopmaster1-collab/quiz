# SECCIÓN: APLICACIÓN — Identidad y ambiente
APP_NAME=MASTER Sensor Quiz
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000

# SECCIÓN: BASE DE DATOS — PostgreSQL local o Render
DATABASE_URL=postgresql+psycopg://masterquiz:masterquiz@localhost:5432/masterquiz

# SECCIÓN: CORS — Dominios autorizados separados por coma
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://master.mx,https://www.master.mx

# SECCIÓN: DEEPSEEK — IA para explicación final
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=700

# SECCIÓN: ADMINISTRACIÓN — Acceso inicial al panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_ESTA_CONTRASENA

# SECCIÓN: CORREO — Reservado para una fase posterior
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
